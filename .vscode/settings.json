{
  // ── Python LSP ──────────────────────────────────────────────────────────
  // Pyrefly (Meta's Rust-based type checker) crashes on this project.
  // Disabling it and using Pylance (ms-python) instead.
  "pyrefly.enabled": false,
  "python.languageServer": "Pylance",
  "python.analysis.typeCheckingMode": "basic",

  // ── Deno ────────────────────────────────────────────────────────────────
  "deno.enablePaths": [
    "supabase/functions"
  ],
  "deno.lint": true,
  "deno.unstable": [
    "bare-node-builtins",
    "byonm",
    "sloppy-imports",
    "unsafe-proto",
    "webgpu",
    "broadcast-channel",
    "worker-options",
    "cron",
    "kv",
    "ffi",
    "fs",
    "http",
    "net"
  ],
  "[typescript]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  }
}
